{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "conahp-agenda-2026",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/auth/login"
    ]
  }
}
